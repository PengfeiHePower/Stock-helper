# LLM providers (Plan A: Gemini L1 + Anthropic L2/L3)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Market data
FINNHUB_API_KEY=
FRED_API_KEY=

# Email (Resend: https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=brief@yourdomain.com
EMAIL_TO=you@example.com

# Slack (optional — leave empty if not used)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_BRIEF_CHANNEL=

# Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEC EDGAR (required User-Agent with contact email)
SEC_USER_AGENT=StockHelper contact@example.com

# Optional overrides
DATABASE_URL=sqlite:///./data/stock_helper.db
BRIEF_TIMEZONE=America/New_York
